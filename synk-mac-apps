#!/bin/bash
# synk-mac-apps: installs and maintains the local web apps described in apps/*.sh,
# each built from source and served by Laravel Herd at https://<domain>.test.
# Builds live in active-setup/ (git-ignored), server apps in ~/.synk-mac-apps. Run with --help.
# Plain /bin/bash 3.2: no associative arrays or mapfile.
set -uo pipefail

REPO=$(cd "$(dirname "$(readlink -f "$0")")" && pwd -P)
SITES="$REPO/active-setup/sites"
HERD_HOME="$HOME/Library/Application Support/Herd"
HERD="$HERD_HOME/bin/herd"
HERD_LINKS="$HERD_HOME/config/valet/Sites"
HERD_CERTS="$HERD_HOME/config/valet/Certificates"
HERD_NGINX="$HERD_HOME/config/valet/Nginx"
NVM_SH="$HERD_HOME/config/nvm/nvm.sh"
# Server apps (TYPE=pm2) run under a PM2 of their own, apart from any other PM2 on
# this Mac. It never runs "pm2 startup" or "pm2 save": a LaunchAgent starts the apps
# when Herd starts, and nothing brings them back after a reboot until Herd runs.
# They live in RUNTIME, not active-setup: macOS blocks launchd jobs from Desktop,
# Documents and Downloads, where this repo may be cloned.
RUNTIME="$HOME/.synk-mac-apps"
PM2_HOME="$RUNTIME/pm2"
PM2_CLI="$RUNTIME/pm2-cli/node_modules/pm2/bin/pm2"
PM2_NODE=24
AGENT_LABEL=com.synk-mac-apps.pm2
AGENT="$HOME/Library/LaunchAgents/$AGENT_LABEL.plist"
YES=
PROBLEMS=0

usage() {
    cat <<EOF
Usage: synk-mac-apps <command> [app] [options]

Commands:
  --setup                 Interactive wizard: prerequisites (Homebrew, gum, Herd),
                          then install, keep, move or remove each app
  --status                Installed apps, versions, last update and HTTP check
  --doctor                Check prerequisites and every installed app; exit 1 on problems
  --update [app|all]      Check for and build new versions now (default: all installed)
  --install [app]         Install or repair an app (asks which when no app is given)
      --domain <name>     Serve it at https://<name>.test (default: manifest or current)
  --uninstall [app]       Remove an app, its build and its Herd link
      -y, --yes           Don't ask for confirmation
  --list                  Apps this repo knows about
  -h, --help              This help

Apps: $(apps | xargs)
Re-running any command is safe: finished steps are detected and skipped.
EOF
}

# ---- UI: gum on a terminal, plain shell otherwise ----
# stdin and stderr: choose/ask run inside $(...), and gum draws its UI on stderr.
tty_ok() { [ -t 0 ] && [ -t 2 ]; }
gum_ok() { tty_ok && command -v gum >/dev/null 2>&1; }
style() { # $1 colour, rest text
    local c=$1; shift
    if gum_ok; then gum style --foreground "$c" "$*"; else printf '%s\n' "$*"; fi
}
info() { style 212 "$*"; }
ok() { style 2 "✓ $*"; }
warn() { style 3 "! $*"; }
fail() { style 1 "✗ $*"; PROBLEMS=1; }
die() { echo "synk-mac-apps: $*" >&2; exit 1; }
header() {
    if gum_ok; then gum style --border rounded --padding "0 2" --border-foreground 212 "$@"
    else printf '\n== %s ==\n' "$*"; fi
}
confirm() { # $1 question; no by default, and always no without a terminal unless --yes
    [ -n "$YES" ] && return 0
    tty_ok || return 1
    if gum_ok; then gum confirm "$1"
    else local r; read -r -p "$1 [y/N] " r; [[ $r =~ ^[Yy] ]]; fi
}
ask() { # $1 prompt, $2 default; prints the answer
    if gum_ok; then gum input --prompt "$1: " --value "$2"
    else local r; read -r -p "$1 [$2]: " r; echo "${r:-$2}"; fi
}
choose() { # $1 header, rest options; prints the choice
    if gum_ok; then gum choose --header "$1" "${@:2}"
    else
        local o; echo "$1" >&2
        select o in "${@:2}"; do [ -n "$o" ] && { echo "$o"; return; }; done
        return 1
    fi
}
spin() { # $1 title, rest an executable (not a function) and its arguments
    if gum_ok; then gum spin --spinner dot --title "$1" -- "${@:2}"
    else echo "$1..."; "${@:2}"; fi
}

# ---- Apps ----
apps() { local f; for f in "$REPO"/apps/*.sh; do basename "$f" .sh; done; }
installed() { [ -f "$SITES/$1/domain" ] || [ -f "$RUNTIME/sites/$1/domain" ]; }
load() { # $1 app: loads its manifest and sets APP, SITE and INSTALLED_DOMAIN
    [ -f "$REPO/apps/$1.sh" ] || die "unknown app '$1' (known: $(apps | xargs))"
    unset -f build app_env latest_version install_version
    TITLE='' ABOUT='' REPO_URL='' DOMAIN='' SOURCE='' STORAGE='' NODE='' ROOT_REDIRECT=''
    TYPE=static PACKAGE='' SCRIPT='' PORT='' EXTRA_PORTS='' IDLE='' SQLITE=''
    source "$REPO/apps/$1.sh"
    APP=$1 SITE="$SITES/$1"
    # A server app keeps its data outside its site folder, so an uninstall leaves it.
    [ "$TYPE" = pm2 ] && SITE="$RUNTIME/sites/$1" DATA="$RUNTIME/data/$1"
    INSTALLED_DOMAIN=$(cat "$SITE/domain" 2>/dev/null || true)
}
http_code() { curl -s -L -o /dev/null -m 10 -w '%{http_code}' "https://$1.test/"; }
linked_here() { [ "$(readlink "$HERD_LINKS/$1" 2>/dev/null)" = "$SITE" ]; }
# Herd's dnsmasq answers every *.test name, so only the HTTP code shows whether a
# name is taken: Herd's own 404 page (or no answer) means free.
domain_free() { # $1 domain: unused, or already this app's
    if [ -L "$HERD_LINKS/$1" ]; then linked_here "$1"; return; fi
    [ "$TYPE" = pm2 ] && proxied_here "$1" && return 0
    local code; code=$(curl -sk -o /dev/null -m 5 -w '%{http_code}' "https://$1.test/")
    [ "$code" = 000 ] || [ "$code" = 404 ]
}
unlink_domain() { # $1 domain; only touches a Herd link that points at this app
    linked_here "$1" || return 0
    "$HERD" unlink "$1" >/dev/null
    if [ -f "$HERD_CERTS/$1.test.crt" ]; then "$HERD" unsecure "$1" >/dev/null; fi
}
unlink_others() { # $1 domain to keep (empty: none); every other Herd link to this app
    local l
    for l in "$HERD_LINKS"/*; do
        [ "$(basename "$l")" = "$1" ] || unlink_domain "$(basename "$l")"
    done
}
update_running() { # site-update.sh holds an flock on update.lock while it runs
    local lock="$SITE/.auto-update/update.lock"
    [ -f "$lock" ] && ! /usr/bin/perl -MFcntl=:flock -e 'open(my $l, "<", shift) or exit 1; flock($l, LOCK_EX | LOCK_NB) or exit 1' "$lock"
}
need_herd() { [ -x "$HERD" ] && [ -f "$NVM_SH" ] || die "Herd (with Node) is not set up; run: synk-mac-apps --setup"; }

run_update() { # $1 app, manifest loaded: check for and build a new version now
    [ "$TYPE" = pm2 ] && { pm2_update; return; }
    local log="$SITE/.auto-update/update.log" start rc
    start=$(date '+%F %T')
    spin "Checking $TITLE for a new version (a build takes a few minutes)" "$REPO/lib/site-update.sh" "$1"; rc=$?
    # The update's own log lines from this run (build output is untimestamped).
    [ -f "$log" ] && awk -v t="$start" '/^[0-9]{4}-[0-9]{2}-[0-9]{2} / && $0 >= t { print "  " $0 }' "$log"
    if [ $rc -ne 0 ]; then
        fail "$TITLE update failed; last lines of $log:"
        tail -n 15 "$log" | sed 's/^/    /'
        return 1
    fi
}

install_app() { # $1 app, $2 domain (optional): install, or repair an installed app
    load "$1"
    local domain=${2:-${INSTALLED_DOMAIN:-$DOMAIN}} code
    domain=$(printf '%s' "${domain%.test}" | tr '[:upper:]' '[:lower:]')
    [[ $domain =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]] || { fail "$TITLE: '$domain' is not a valid name"; return 1; }
    domain_free "$domain" || { fail "$TITLE: https://$domain.test is already used by another site"; return 1; }
    info "$TITLE → https://$domain.test"
    [ "$TYPE" = pm2 ] && { install_pm2 "$domain"; return; }

    mkdir -p "$SITE"
    if [ ! -d "$SITE/src/.git" ]; then
        rm -rf "$SITE/src" "$SITE/src.tmp"
        spin "Cloning $REPO_URL" git clone -q --depth 1 "$REPO_URL" "$SITE/src.tmp" &&
            mv "$SITE/src.tmp" "$SITE/src" || { fail "$TITLE: clone failed"; return 1; }
    fi
    ln -sfn ../../../lib/LocalValetDriver.php "$SITE/LocalValetDriver.php"
    if [ -n "$ROOT_REDIRECT" ]; then echo "$ROOT_REDIRECT" > "$SITE/root-redirect"; else rm -f "$SITE/root-redirect"; fi
    if [ ! -f "$SITE/dist/index.html" ]; then run_update "$APP" || return 1; fi

    linked_here "$domain" || (cd "$SITE" && "$HERD" link "$domain" >/dev/null) || { fail "$TITLE: herd link failed"; return 1; }
    [ -f "$HERD_CERTS/$domain.test.crt" ] || "$HERD" secure "$domain" >/dev/null || { fail "$TITLE: herd secure failed"; return 1; }
    echo "$domain" > "$SITE/domain"
    # The old domain after a move, and any link left by an interrupted move.
    unlink_others "$domain"

    wait_live "$domain" 10
}

wait_live() { # $1 domain, $2 seconds to wait for an answer other than 000 or 502
    # herd link/secure/proxy reload nginx, which refuses connections for a moment,
    # and a server app answers 502 until it has started.
    local code try=1
    while code=$(http_code "$1"); [ "$code" = 000 ] || [ "$code" = 502 ]; do
        [ $try -lt "$2" ] || break
        try=$((try + 1)); sleep 1
    done
    if [ "$code" = 200 ]; then ok "$TITLE is live at https://$1.test"
    else fail "$TITLE: https://$1.test answered HTTP $code"; return 1; fi
}

# ---- Server apps (TYPE=pm2): run by PM2 behind a Herd proxy ----
# An npm PACKAGE run by Node, or a binary the manifest's latest_version and
# install_version fetch.
proxied_here() { grep -q "proxy_pass http://127.0.0.1:$PORT;" "$HERD_NGINX/$1.test" 2>/dev/null; }
node_bin() { # $1 major version: Herd's nvm node binary, installed if missing
    # Only when missing: "nvm install" fetches each new patch, which changes the path.
    (set +u; source "$NVM_SH" --no-use; nvm which "$1" >/dev/null 2>&1 || nvm install "$1" --no-progress >/dev/null 2>&1
        nvm which "$1") 2>/dev/null
}
npm_for() { local d; d=$(dirname "$1"); NPM=(env "PATH=$d:$PATH" "$d/npm"); } # $1 node binary; sets NPM
logged() { # $1 title, $2 log, rest an executable: runs it under spin, output appended to the log
    # shellcheck disable=SC2016 # expanded by the inner bash
    spin "$1" /bin/bash -c '"${@:2}" >>"$1" 2>&1' - "$2" "${@:3}"
}
ensure_pm2() { # sets PM2_BIN, installing PM2 into RUNTIME the first time
    [ -n "${PM2_BIN:-}" ] && return
    local bin; bin=$(node_bin "$PM2_NODE")
    [ -x "$bin" ] || { fail "Herd's nvm could not provide Node $PM2_NODE"; return 1; }
    mkdir -p "$PM2_HOME"
    if ! "$bin" "$PM2_CLI" --version >/dev/null 2>&1; then
        npm_for "$bin"
        logged "Installing PM2" "$PM2_HOME/install.log" "${NPM[@]}" install --prefix "$RUNTIME/pm2-cli" \
            --no-audit --no-fund pm2 || { fail "PM2 install failed; see $PM2_HOME/install.log"; return 1; }
    fi
    PM2_BIN=$bin
}
# PM2 passes its caller's environment on to the apps, so give it none: an exported
# DB_TYPE or NODE_OPTIONS from this shell would otherwise reach n8n.
pm2() { env -i HOME="$HOME" USER="$USER" PATH=/usr/bin:/bin:/usr/sbin:/sbin PM2_HOME="$PM2_HOME" "$PM2_BIN" "$PM2_CLI" "$@"; }
pm2_state() { # $1 app: online, stopped, errored...; empty when PM2 or the app isn't running
    kill -0 "$(cat "$PM2_HOME/pm2.pid" 2>/dev/null)" 2>/dev/null || return 0
    pm2 jlist 2>/dev/null | "$PM2_BIN" -e '
        let s = ""; process.stdin.on("data", d => s += d).on("end", () => {
            const a = JSON.parse(s || "[]").find(x => x.name === process.argv[1]);
            console.log(a ? a.pm2_env.status : "");
        });' "$1"
}
pm2_online() { [ "$(pm2_state "$APP")" = online ]; }
pm2_apps_installed() {
    local a
    for a in $(apps); do (load "$a"; [ "$TYPE" = pm2 ] && installed "$a") && return 0; done
    return 1
}

write_ecosystem() { # $1 domain, $2 node binary or "none" for a binary app: writes the PM2 definition; sets ECO_CHANGED
    local f="$SITE/ecosystem.json" script="$SITE/current/$SCRIPT" interp=$2 bin=$2 wrap=()
    [ "$bin" = none ] && bin=$PM2_BIN
    mkdir -p "$DATA" "$SITE/logs"
    if [ -n "$IDLE" ]; then
        # idle-exit.sh stops the app after IDLE quiet seconds; a copy, as PM2 may not read the repo.
        cp -f "$REPO/lib/idle-exit.sh" "$RUNTIME/idle-exit.sh" || return 1
        wrap=("$IDLE" "$DATA" "$PORT $EXTRA_PORTS")
        [ "$interp" = none ] || wrap+=("$interp")
        wrap+=("$script")
        script="$RUNTIME/idle-exit.sh" interp=/bin/bash
    fi
    app_env "$1" | "$PM2_BIN" -e '
        const [name, cwd, script, interpreter, bindir, log, ...args] = process.argv.slice(1);
        let s = ""; process.stdin.on("data", d => s += d).on("end", () => {
            // The app finds node (for its own child processes) on PATH: its own version.
            const env = { PATH: bindir + ":/usr/bin:/bin:/usr/sbin:/sbin" };
            for (const l of s.split("\n")) { const i = l.indexOf("="); if (i > 0) env[l.slice(0, i)] = l.slice(i + 1); }
            const app = { name, cwd, script, interpreter, args, env,
                out_file: log, error_file: log, max_restarts: 10, restart_delay: 5000,
                kill_timeout: 30000 }; // n8n takes up to 30s to finish running workflows
            // idle-exit.sh exits 0 after an idle stop: not a crash, so no restart.
            if (args.length) app.stop_exit_codes = [0];
            console.log(JSON.stringify({ apps: [app] }, null, 2));
        });' "$APP" "$SITE" "$script" "$interp" "$(dirname "$bin")" "$SITE/logs/$APP.log" ${wrap[@]+"${wrap[@]}"} > "$f.tmp" || return 1
    ECO_CHANGED=
    if cmp -s "$f.tmp" "$f"; then rm -f "$f.tmp"; else mv -f "$f.tmp" "$f"; ECO_CHANGED=1; fi
}

pm2_update() { # manifest loaded: install the newest release unless it is already live
    local dir="$SITE/.auto-update" log node v cur d db rc
    log="$dir/update.log"
    ensure_pm2 || return 1
    mkdir -p "$dir" "$SITE/builds"
    if [ -n "$PACKAGE" ]; then
        node=$(node_bin "$NODE"); [ -x "$node" ] || { fail "$TITLE: Herd's nvm could not provide Node $NODE"; return 1; }
        npm_for "$node"
        v=$("${NPM[@]}" view "$PACKAGE" version 2>/dev/null)
    else
        v=$(latest_version 2>/dev/null)
    fi
    [ -n "$v" ] || { fail "$TITLE: could not find the newest version"; return 1; }
    date '+%F %T' > "$dir/last-check"
    cur=$(basename "$(readlink "$SITE/current" 2>/dev/null)")
    if [ "$v" = "$cur" ] && [ -f "$SITE/current/$SCRIPT" ]; then ok "$TITLE $v is the newest version"; return 0; fi

    echo "$(date '+%F %T') installing $TITLE $v" >> "$log"
    rm -rf "${SITE:?}/builds/$v"
    if [ -n "$PACKAGE" ]; then
        logged "Installing $TITLE $v (takes a few minutes)" "$log" "${NPM[@]}" install --prefix "$SITE/builds/$v" \
            --omit=dev --no-audit --no-fund "$PACKAGE@$v"
    else
        echo "Downloading $TITLE $v..."
        mkdir -p "$SITE/builds/$v" && install_version "$v" "$SITE/builds/$v" >> "$log" 2>&1
    fi
    rc=$?
    if [ $rc -ne 0 ] || [ ! -f "$SITE/builds/$v/$SCRIPT" ]; then
        echo "$(date '+%F %T') FAILED installing $TITLE $v" >> "$log"
        rm -rf "${SITE:?}/builds/$v"
        fail "$TITLE $v install failed; last lines of $log:"
        tail -n 15 "$log" | sed 's/^/    /'
        return 1
    fi
    # A new version may migrate the database on its first start, so keep a copy of
    # the old one (sqlite's .backup is safe while the app runs). Only the newest is kept.
    db="$DATA/$SQLITE"
    if [ -n "$SQLITE" ] && [ -f "$db" ]; then
        /usr/bin/sqlite3 "$db" ".backup '$db.before-$v.tmp'" && mv -f "$db.before-$v.tmp" "$db.before-$v" ||
            { rm -f "$db.before-$v.tmp"; fail "$TITLE: could not back up $db; kept $cur"; return 1; }
        for d in "$db".before-*; do [ "$d" = "$db.before-$v" ] || rm -f "$d"; done
    fi
    ln -sfn "builds/$v" "$SITE/current.tmp" && mv -fh "$SITE/current.tmp" "$SITE/current"
    echo "$v $(date '+%F %T')" > "$dir/last-updated"
    echo "$(date '+%F %T') live: $v" >> "$log"
    for d in "$SITE"/builds/*; do
        [ "$d" = "$SITE/builds/$v" ] || [ "$d" = "$SITE/builds/$cur" ] || rm -rf "$d"
    done
    if pm2_online; then pm2 restart "$SITE/ecosystem.json" >/dev/null || { fail "$TITLE: PM2 could not restart it"; return 1; }; fi
    ok "$TITLE $v installed"
}

install_pm2() { # $1 domain, manifest loaded: install or repair a server app
    local domain=$1 node=none state p
    ensure_pm2 || return 1
    if [ -n "$NODE" ]; then
        node=$(node_bin "$NODE"); [ -x "$node" ] || { fail "$TITLE: Herd's nvm could not provide Node $NODE"; return 1; }
    fi
    mkdir -p "$SITE"
    [ -f "$SITE/current/$SCRIPT" ] || pm2_update || return 1
    write_ecosystem "$domain" "$node" || { fail "$TITLE: could not write $SITE/ecosystem.json"; return 1; }
    state=$(pm2_state "$APP")
    for p in $PORT $EXTRA_PORTS; do
        if [ "$state" != online ] && lsof -nP -iTCP:"$p" -sTCP:LISTEN >/dev/null 2>&1; then
            fail "$TITLE: port $p is used by another program"; return 1
        fi
    done
    if [ "$state" != online ] || [ -n "$ECO_CHANGED" ]; then
        pm2 startOrRestart "$SITE/ecosystem.json" >/dev/null || { fail "$TITLE: PM2 could not start it"; return 1; }
    fi
    proxied_here "$domain" || "$HERD" proxy "$domain" "http://127.0.0.1:$PORT" --secure >/dev/null ||
        { fail "$TITLE: herd proxy failed"; return 1; }
    echo "$domain" > "$SITE/domain"
    # The old domain after a move.
    if [ -n "$INSTALLED_DOMAIN" ] && [ "$INSTALLED_DOMAIN" != "$domain" ] && proxied_here "$INSTALLED_DOMAIN"; then
        "$HERD" unproxy "$INSTALLED_DOMAIN" >/dev/null
    fi
    install_agent || return 1
    # The first start sets up the database, which takes a while.
    wait_live "$domain" 90
}

# The LaunchAgent runs RUNTIME/herd-start.sh at login and whenever Herd starts or
# stops. The script stands alone because launchd may not read this repo (see RUNTIME).
agent_loaded() { launchctl print "gui/$(id -u)/$AGENT_LABEL" >/dev/null 2>&1; }
install_agent() { # needs ensure_pm2
    local run="$RUNTIME/herd-start.sh"
    {
        echo '#!/bin/bash'
        echo '# Written by synk-mac-apps: while Herd runs, start the server apps PM2 is not running.'
        printf 'export PM2_HOME=%q\nnode=%q\npm2=%q\nsites=%q\n' "$PM2_HOME" "$PM2_BIN" "$PM2_CLI" "$RUNTIME/sites"
        cat <<'EOF'
pgrep -xq Herd || exit 0
# "pm2 start" restarts an app that is already running, so start only those that aren't.
# Without a daemon nothing runs, and jlist would print its startup notice before the JSON.
online=
if kill -0 "$(cat "$PM2_HOME/pm2.pid" 2>/dev/null)" 2>/dev/null; then online=$(env -i HOME="$HOME" PATH=/usr/bin:/bin:/usr/sbin:/sbin PM2_HOME="$PM2_HOME" "$node" "$pm2" jlist 2>/dev/null | "$node" -e '
    let s = ""; process.stdin.on("data", d => s += d).on("end", () => {
        for (const a of JSON.parse(s || "[]")) if (a.pm2_env.status === "online") console.log(a.name);
    });') || exit 1
fi
for f in "$sites"/*/ecosystem.json; do
    [ -f "$f" ] || continue
    app=$(basename "$(dirname "$f")")
    printf '%s\n' "$online" | grep -qx "$app" && continue
    echo "$(date '+%F %T') Herd is running; starting $app"
    env -i HOME="$HOME" PATH=/usr/bin:/bin:/usr/sbin:/sbin PM2_HOME="$PM2_HOME" "$node" "$pm2" start "$f" >/dev/null
done
EOF
    } > "$run"
    mkdir -p "$(dirname "$AGENT")"
    cat > "$AGENT.tmp" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>$AGENT_LABEL</string>
    <key>ProgramArguments</key><array><string>/bin/bash</string><string>$run</string></array>
    <key>RunAtLoad</key><true/>
    <!-- Herd writes its pid files here when it starts. -->
    <key>WatchPaths</key><array><string>$HERD_HOME/.pid</string></array>
    <key>StandardOutPath</key><string>$RUNTIME/herd-start.log</string>
    <key>StandardErrorPath</key><string>$RUNTIME/herd-start.log</string>
</dict>
</plist>
EOF
    if cmp -s "$AGENT.tmp" "$AGENT"; then rm -f "$AGENT.tmp"
    else
        mv -f "$AGENT.tmp" "$AGENT"; launchctl bootout "gui/$(id -u)/$AGENT_LABEL" 2>/dev/null
        local i; for i in 1 2 3 4 5; do agent_loaded || break; sleep 1; done # bootout finishes asynchronously
    fi
    agent_loaded || launchctl bootstrap "gui/$(id -u)" "$AGENT" || { fail "could not load $AGENT"; return 1; }
}
remove_agent() { launchctl bootout "gui/$(id -u)/$AGENT_LABEL" 2>/dev/null; rm -f "$AGENT" "$RUNTIME/herd-start.sh"; }

uninstall_app() { # $1 app
    load "$1"
    [ -d "$SITE" ] || { warn "$TITLE is not installed"; return 0; }
    [ -n "$YES" ] || tty_ok || die "add -y to uninstall without a terminal"
    local kept="Data saved in the browser stays there for a reinstall on the same domain."
    [ "$TYPE" = pm2 ] && kept="Its data stays in $DATA for a reinstall."
    confirm "Remove $TITLE${INSTALLED_DOMAIN:+ (https://$INSTALLED_DOMAIN.test)}? $kept" ||
        { echo "Kept $TITLE."; return 0; }
    ! update_running || { fail "$TITLE is updating right now; try again in a few minutes"; return 1; }
    if [ "$TYPE" = pm2 ]; then
        ensure_pm2 || return 1
        # Removing the files under a running app would leave it holding its port.
        [ -z "$(pm2_state "$APP")" ] || pm2 delete "$APP" >/dev/null || { fail "$TITLE: PM2 could not stop it"; return 1; }
        [ -n "$INSTALLED_DOMAIN" ] && proxied_here "$INSTALLED_DOMAIN" && "$HERD" unproxy "$INSTALLED_DOMAIN" >/dev/null
    else
        unlink_others ""
    fi
    rm -rf "${SITE:?}"
    # The last server app gone: stop PM2 and stop starting it with Herd.
    if [ "$TYPE" = pm2 ] && ! pm2_apps_installed; then
        [ -z "${PM2_BIN:-}" ] || pm2 kill >/dev/null 2>&1
        remove_agent
    fi
    ok "Removed $TITLE"
}

pick_app() { # $1 header, $2 "installed" or "available"; prints the app
    tty_ok || die "name an app: $(apps | xargs)"
    local a list=()
    for a in $(apps); do
        if installed "$a"; then [ "$2" = installed ] && list+=("$a")
        else [ "$2" = available ] && list+=("$a"); fi
    done
    [ ${#list[@]} -gt 0 ] || die "no $2 apps"
    choose "$1" "${list[@]}"
}

list() {
    local a
    for a in $(apps); do
        load "$a"
        printf '%s\t%s\t%s\n' "$a" "$ABOUT" "$(installed "$a" && echo "https://$INSTALLED_DOMAIN.test" || echo "default $DOMAIN.test")"
    done | column -t -s $'\t'
}

status() {
    local a
    {
        printf 'APP\tURL\tVERSION\tUPDATED\tCHECKED\tHTTP\n'
        for a in $(apps); do
            load "$a"
            if ! installed "$a"; then printf '%s\t-\tnot installed\t-\t-\t-\n' "$a"; continue; fi
            printf '%s\thttps://%s.test\t%s\t%s\t%s\t%s\n' "$a" "$INSTALLED_DOMAIN" \
                "$(basename "$(readlink "$SITE/dist" || readlink "$SITE/current")")" \
                "$(cut -d' ' -f2 "$SITE/.auto-update/last-updated" 2>/dev/null || echo -)" \
                "$(cut -c1-10 "$SITE/.auto-update/last-check" 2>/dev/null || echo -)" \
                "$(http_code "$INSTALLED_DOMAIN")"
        done
    } | column -t -s $'\t'
}

# ---- Doctor ----
check() { # $1 description, rest a command that succeeds when all is well
    if "${@:2}" >/dev/null 2>&1; then ok "$1"; else fail "$1"; fi
}
command_linked() { [ "$(readlink -f "$(command -v synk-mac-apps)")" = "$REPO/synk-mac-apps" ]; }
src_clean() { [ -z "$(git -C "$SITE/src" status --porcelain)" ]; }
driver_linked() { [ "$(readlink -f "$SITE/LocalValetDriver.php")" = "$REPO/lib/LocalValetDriver.php" ]; }
serves() { [ "$(http_code "$1")" = 200 ]; }
last_update_ok() { ! grep '^[0-9]\{4\}-' "$SITE/.auto-update/update.log" | tail -1 | grep -q FAILED; }

doctor() {
    local a d
    header "Prerequisites"
    check "Homebrew" command -v brew
    check "gum" command -v gum
    check "git" git --version
    check "Herd" test -x "$HERD"
    check "Herd's Node (nvm)" test -f "$NVM_SH"
    check "synk-mac-apps command points at $REPO" command_linked
    for a in $(apps); do
        load "$a"
        if ! installed "$a"; then
            [ -d "$SITE" ] && warn "$a: half installed; run synk-mac-apps --install $a"
            continue
        fi
        d=$INSTALLED_DOMAIN
        header "$TITLE (https://$d.test)"
        if [ "$TYPE" = pm2 ]; then
            # A check only: never download Node or PM2 here.
            [ -f "$PM2_CLI" ] && ensure_pm2 || { fail "PM2 is not installed; run synk-mac-apps --install $a"; continue; }
            check "live version $(basename "$(readlink "$SITE/current")")" test -f "$SITE/current/$SCRIPT"
            check "Herd proxies $d.test to port $PORT" proxied_here "$d"
            check "HTTPS certificate" test -f "$HERD_CERTS/$d.test.crt"
            check "starts when Herd starts (LaunchAgent)" agent_loaded
            if [ -n "$IDLE" ] && [ "$(pm2_state "$APP")" = stopped ]; then
                ok "stopped after $((IDLE / 60)) idle minutes; starts with Herd, or now with: synk-mac-apps --install $a"
            else
                check "PM2 runs it" pm2_online
                check "serves HTTP 200" serves "$d"
            fi
            check "last update did not fail" last_update_ok
            continue
        fi
        check "source checkout is clean" src_clean
        check "driver links to lib/" driver_linked
        check "Herd links $d.test here" linked_here "$d"
        check "HTTPS certificate" test -f "$HERD_CERTS/$d.test.crt"
        check "live build $(basename "$(readlink "$SITE/dist")")" test -f "$SITE/dist/index.html"
        check "serves HTTP 200" serves "$d"
        check "last update did not fail" last_update_ok
    done
    for d in "$SITES"/*; do
        [ -d "$d" ] && [ ! -f "$REPO/apps/$(basename "$d").sh" ] && warn "$d has no manifest in apps/"
    done
    if [ $PROBLEMS = 0 ]; then echo; ok "All good"; else echo; fail "Problems found; synk-mac-apps --install <app> repairs most"; fi
    return $PROBLEMS
}

# ---- Setup ----
brew_env() {
    command -v brew >/dev/null && return
    local b
    for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        [ -x "$b" ] && { eval "$("$b" shellenv)"; return; }
    done
    return 1
}

ensure_prereqs() {
    header "Prerequisites"
    if ! brew_env; then
        confirm "Homebrew is missing. Install it with its official installer?" || { fail "Homebrew is required"; return 1; }
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" && brew_env || return 1
    fi
    ok "Homebrew"
    command -v gum >/dev/null || brew install gum || return 1
    ok "gum"
    git --version >/dev/null 2>&1 || brew install git || return 1
    ok "git"
    if [ ! -x "$HERD" ]; then
        confirm "Laravel Herd (nginx, dnsmasq, PHP and Node behind *.test) is missing. Install it?" ||
            { fail "Herd is required"; return 1; }
        brew install --cask herd || return 1
        open -a Herd
        info "Finish Herd's first-run setup in its window (it asks for your password once)."
    fi
    until [ -x "$HERD" ] && [ -d "$HERD_LINKS" ]; do confirm "Has Herd finished its setup?" || return 1; done
    ok "Herd"
    until [ -f "$NVM_SH" ]; do
        info "Turn on Node in Herd > Settings > Node; its nvm builds the apps."
        confirm "Done?" || return 1
    done
    ok "Herd's Node"
    local bin; bin="$(brew --prefix)/bin/synk-mac-apps"
    if [ -e "$bin" ] && [ ! -L "$bin" ]; then warn "$bin exists and is not a link; left alone"
    else ln -sfn "$REPO/synk-mac-apps" "$bin" && ok "synk-mac-apps command"; fi
}

setup() {
    tty_ok || die "--setup is interactive; use --install <app> in scripts"
    header "synk-mac-apps setup" "Local web apps built from source, served by Herd at https://<name>.test"
    ensure_prereqs || return 1
    local a d
    for a in $(apps); do
        load "$a"
        echo; info "$TITLE: $ABOUT"
        if installed "$a"; then
            case $(choose "Installed at https://$INSTALLED_DOMAIN.test" "Keep (check and repair)" "Update now" "Change domain" "Uninstall") in
                Keep*) install_app "$a" ;;
                "Update now") run_update "$a" ;;
                "Change domain") d=$(ask "Domain (.test is added)" "$INSTALLED_DOMAIN") && install_app "$a" "$d" ;;
                Uninstall) uninstall_app "$a" ;;
            esac
        else
            case $(choose "Install $TITLE?" "Install" "Skip") in
                Install) d=$(ask "Domain (.test is added)" "$DOMAIN") && install_app "$a" "$d" ;;
            esac
        fi
    done
    echo; header "Status"; status
}

main() {
    local cmd=${1:---help} app='' domain='' a rc=0
    [ $# -gt 0 ] && shift
    while [ $# -gt 0 ]; do
        case $1 in
            --domain) [ $# -ge 2 ] || die "--domain needs a name"; domain=$2; shift 2 ;;
            --domain=*) domain=${1#*=}; shift ;;
            -y|--yes) YES=1; shift ;;
            -*) die "unknown option $1" ;;
            *) app=$1; shift ;;
        esac
    done
    case $cmd in
        --setup) setup ;;
        --status) status ;;
        --doctor) doctor ;;
        --list) list ;;
        --update)
            need_herd
            if [ -z "$app" ] || [ "$app" = all ]; then app=$(for a in $(apps); do installed "$a" && echo "$a"; done)
            else installed "$app" || die "$app is not installed"; fi
            [ -n "$app" ] || die "no apps installed; run synk-mac-apps --setup"
            for a in $app; do load "$a"; run_update "$a" || rc=1; done
            return $rc ;;
        --install)
            need_herd
            [ -n "$app" ] || app=$(pick_app "Install which app?" available) || exit 1
            if [ -z "$domain" ] && tty_ok && ! installed "$app"; then
                load "$app"; domain=$(ask "Domain for $TITLE (.test is added)" "$DOMAIN") || exit 1
            fi
            install_app "$app" "$domain" ;;
        --uninstall)
            [ -n "$app" ] || app=$(pick_app "Uninstall which app?" installed) || exit 1
            uninstall_app "$app" ;;
        -h|--help) usage ;;
        *) usage >&2; exit 1 ;;
    esac
}

main "$@"
